# Docker Compose (optional; enables `docker compose up` without --profile)
# COMPOSE_PROFILES=dev

# Postgres (API + Hangfire). In Compose, services use Host=postgres;Port=5432.
# docker-compose.yml postgres credentials must match Username/Password/Database here.
ConnectionStrings__Default=Host=postgres;Port=5432;Database=retrohiscore;Username=retrohiscore;Password=retrohiscore
# Host tools (mapped port 15432): Host=localhost;Port=15432;Database=retrohiscore;Username=retrohiscore;Password=retrohiscore
# URI: postgresql://retrohiscore:retrohiscore@localhost:15432/retrohiscore

# RetroAchievements (shared catalog key for add-game / metadata sync)
RA__Username=
RA__ApiKey=
RA__BaseUrl=https://retroachievements.org/API
RA__MediaBaseUrl=https://media.retroachievements.org

# Sync (schedule intervals are stored in the database; edit in Admin → Sync schedules)
Sync__ManualCooldownSeconds=60
Sync__PerGameRefreshCooldownSeconds=60
Sync__DispatchStaggerSeconds=3
GameMetadataSync__ManualCooldownSeconds=300
ConsoleIconSync__ManualCooldownSeconds=300
ConsoleIconSync__ForceRefresh=false

# Hangfire / Scalar protection (required in Production; send header X-Dashboard-Secret, not query strings)
Hangfire__DashboardPath=/hangfire
Hangfire__DashboardSecret=
Scalar__DashboardSecret=

# Data Protection key ring (required in Production; base64-encoded XML key ring, never commit)
# Generate with: dotnet user-secrets or ASP.NET data protection key management tools
DataProtection__KeyRingXml=

# Discord notifications (optional)
Notifications__DiscordWebhookUrl=
Notifications__NotifyOnRankChange=true
Notifications__NotifyOnNewLead=true

# OpenTelemetry (Compose: apps send OTLP to otel-collector; host Prometheus scrapes COLLECTOR_PORT)
COLLECTOR_ENABLED=true
COLLECTOR_PORT=8889
COLLECTOR_FREQUENCY=60
# Host dev (mise run api / web): map collector OTLP to host ports below (defaults avoid conflict with other stacks on 4317).
COLLECTOR_OTLP_GRPC_HOST_PORT=14317
COLLECTOR_OTLP_HTTP_HOST_PORT=14318
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:14317
Telemetry__OtlpEndpoint=http://localhost:14317

# API
ASPNETCORE_URLS=http://+:8080
ASPNETCORE_ENVIRONMENT=Development

# Web — dev-only admin theme palette lab (/admin/theme-lab). Omit or false in production.
THEME_LAB_ENABLED=false

# Web — server-only calls to the API (SSR and server actions). Not exposed to the browser.
API_URL=http://api:8080
# Host dev (next dev + API on host): API_URL=http://localhost:18943

# Auth — Discord redirect: {AUTH_URL}/api/auth/callback/discord (default AUTH_URL: http://localhost:18321)
AUTH_SECRET=
AUTH_URL=http://localhost:18321
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
AUTH_ADMIN_DISCORD_USER_IDS=
# Server-to-server sign-in invite check (required in Production; must match on API and web)
AUTH_SIGN_IN_SERVICE_KEY=
# Optional JWT claims (defaults shown); API Auth:JwtIssuer / Auth:JwtAudience must match
AUTH_JWT_ISSUER=retro-hiscore-web
AUTH_JWT_AUDIENCE=retro-hiscore-api
