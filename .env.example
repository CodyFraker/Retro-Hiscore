# Docker Compose (optional; enables `docker compose up` without --profile)
# COMPOSE_PROFILES=dev

# Postgres
POSTGRES_USER=retrohiscore
POSTGRES_PASSWORD=retrohiscore
POSTGRES_DB=retrohiscore
POSTGRES_HOST_PORT=15432
ConnectionStrings__Default=Host=postgres;Port=5432;Database=retrohiscore;Username=retrohiscore;Password=retrohiscore
# Local DB editor (host → mapped POSTGRES_HOST_PORT): Host=localhost;Port=15432;Database=retrohiscore;Username=retrohiscore;Password=retrohiscore
# URI: postgresql://retrohiscore:retrohiscore@localhost:15432/retrohiscore

# RetroAchievements (shared catalog key for add-game / metadata sync)
RA__Username=
RA__ApiKey=
RA__BaseUrl=https://retroachievements.org/API
RA__MediaBaseUrl=https://media.retroachievements.org
RA__TrackedGameIds__0=38130
RA__TrackedGameIds__1=2291
RA__TrackedGameIds__2=789

# Sync
Sync__IntervalMinutes=15
Sync__ManualCooldownSeconds=60
GameMetadataSync__ManualCooldownSeconds=300
ConsoleIconSync__ManualCooldownSeconds=300
ConsoleIconSync__ForceRefresh=false

# Hangfire / Scalar protection (optional shared secret header X-Dashboard-Secret)
Hangfire__DashboardPath=/hangfire
Hangfire__DashboardSecret=
Scalar__DashboardSecret=

# Discord notifications (optional)
Notifications__DiscordWebhookUrl=
Notifications__NotifyOnRankChange=true
Notifications__NotifyOnNewLead=true

# API
ASPNETCORE_URLS=http://+:8080
ASPNETCORE_ENVIRONMENT=Development

# Web (browser → API host port; container SSR → internal api service)
NEXT_PUBLIC_API_URL=http://localhost:18943
API_URL=http://api:8080

# Discord OAuth (register redirect: http://localhost:18321/api/auth/callback/discord)
AUTH_SECRET=
AUTH_URL=http://localhost:18321
NEXTAUTH_URL=http://localhost:18321
NEXTAUTH_SECRET=
# Set NEXTAUTH_SECRET to the same value as AUTH_SECRET
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
# Required: comma-separated bootstrap admin Discord user IDs (also seeded as invited members)
AUTH_ADMIN_DISCORD_USER_IDS=
# Server-to-server sign-in check (defaults to AUTH_SECRET when unset)
AUTH_SIGN_IN_SERVICE_KEY=

# API auth (JwtSigningKey must match AUTH_SECRET)
Auth__JwtSigningKey=
Auth__WebOrigin=http://localhost:18321
