FROM mcr.microsoft.com/dotnet/sdk:10.0
WORKDIR /src

COPY apps/api/RetroHiscore.Api.csproj apps/api/
RUN dotnet restore apps/api/RetroHiscore.Api.csproj
COPY apps/api/ apps/api/

ENV ASPNETCORE_URLS=http://+:8080
ENV DOTNET_USE_POLLING_FILE_WATCHER=1
ENV DOTNET_WATCH_SUPPRESS_BROWSER_REFRESH=1

EXPOSE 8080
ENTRYPOINT ["dotnet", "watch", "--non-interactive", "run", "--project", "apps/api/RetroHiscore.Api.csproj", "--urls", "http://+:8080"]
