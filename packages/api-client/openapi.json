{
  "openapi": "3.0.1",
  "info": {
    "title": "Retro Hiscore API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/dashboard": {
      "get": {
        "operationId": "getDashboard",
        "tags": ["Dashboard"],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DashboardResponse" }
              }
            }
          }
        }
      }
    },
    "/api/rivalry/{usernameA}/{usernameB}": {
      "get": {
        "operationId": "getRivalry",
        "tags": ["Rivalry"],
        "parameters": [
          { "name": "usernameA", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "usernameB", "in": "path", "required": true, "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RivalryResponse" }
              }
            }
          },
          "404": { "description": "Not Found" }
        }
      }
    },
    "/api/members": {
      "get": {
        "operationId": "getMembers",
        "tags": ["Members"],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/MemberDto" }
                }
              }
            }
          }
        }
      }
    },
    "/api/members/me": {
      "get": {
        "operationId": "getCurrentMember",
        "tags": ["Members"],
        "responses": {
          "200": {
            "description": "OK",
